#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>

#define windows C_AC_DESKTOP_SHOW_ALL_WINDOWS
#define bri_up C_BRI_UP
#define bri_dn C_BRI_DN
#define dict C_VOICE_COMMAND
#define vol_up C_VOL_UP
#define vol_dn C_VOL_DN
#define vol_mt C_MUTE

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
    };
    keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Mac Layer";
                        bindings = <
                          &kp N2   &kp N3   &kp N4   &kp N5                           &kp N6   &kp N7   &kp N8   &kp N9
                 &kp N1   &kp W    &kp E    &kp R    &kp T                            &kp Y    &kp U    &kp I    &kp O    &kp N0
        &kp ESC  &kp Q    &kp S    &kp D    &kp F    &kp G                            &kp H    &kp J    &kp K    &kp L    &kp P
        &kp TAB  &kp A    &kp X    &kp C    &kp V    &kp B                            &kp N    &kp M   &kp COMMA &kp DOT  &kp SEMI
        &mo 3    &kp Z  &kp MINUS &kp EQUAL &mo 2    &kp SPACE &kp LSHFT                      &kp LCTRL &kp LBKT &kp RBKT &kp FSLH
                                                     &kp LGUI  &kp LALT      &kp BSPC &kp RET
                        >;
                };
                windows_layer {
                        display-name = "Windows Layer";
                        bindings = <
                          &trans   &trans   &trans   &trans                           &trans   &trans   &trans   &trans
                 &trans   &trans   &trans   &trans   &trans                           &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans                           &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans                           &trans   &trans   &trans   &trans   &trans
        &trans   &trans   &trans   &trans   &trans   &trans    &trans                          &kp LGUI &trans   &trans   &trans
                                                     &kp LCTRL &trans        &trans   &trans
                        >;
                };
                function_layer {
                        display-name = "Function Layer";
                        bindings = <
                                &kp F2       &kp F3         &kp F4      &kp F5                             &kp F6          &kp F7         &kp F8         &kp F9
                 &kp F1         &kp bri_up   &kp dict       &kp windows &kp C_PP                           &kp C_MUTE      &kp vol_dn     &kp vol_up     &kp F11        &kp F10
        &kp ESC  &kp bri_dn     &mt AT KP_N2 &mt HASH KP_N3 &mt DLLR KP_N4 &mt PRCNT KP_N5                 &mt CARET KP_N6 &mt AMPS KP_N7 &mt STAR KP_N8 &mt LPAR KP_N9 &kp F12
        &kp TAB  &mt EXCL KP_N1 &kp X        &kp C          &kp V       &kp B                              &kp TAB         &mt EXCL N1    &kp X          &kp C          &mt RPAR KP_N0
        &kp A    &kp Z          &kp MINUS    &kp EQUAL      &trans      &kp SPACE &kp LSHFT                                &kp LCTRL      &kp LBKT       &kp RBKT       &kp SPACE
                                                                        &kp LGUI  &kp LALT        &kp BSPC &kp RET
                        >;
                };
                bluetooth_layer {
                        display-name = "Bluetooth Layer";
                        bindings = <
                             &bt BT_CLR_ALL &bt BT_CLR   &none        &none                               &none &none &none &none
                 &bootloader &none          &none        &none        &none                               &none &none &none &none &bootloader
        &none    &none       &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &none                               &none &none &none &none &none
        &none    &none       &none          &none        &none        &none                               &none &none &none &none &none
        &trans   &none       &none          &none        &none        &tog 1    &studio_unlock                  &none &none &none &none
                                                                      &none     &none               &none &none
                        >;
                };
        };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
                          &kp N2   &kp N3   &kp N4   &kp N5
                 &kp N1   &kp W    &kp E    &kp R    &kp T
        &kp A    &kp Q    &kp S    &kp D    &kp F    &kp G
        &kp A    &kp A    &kp X    &kp C    &kp V    &kp B
        &kp A    &kp Z    &kp A    &kp A    &kp A    &kp SPACE &kp LSHFT
                                                &studio_unlock &kp A
                        >;
                };
        };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
                          &kp 2    &kp 3    &kp 4    &kp 5
                 &kp 1    &kp W    &kp E    &kp R    &kp T
        &kp A    &kp Q    &kp S    &kp D    &kp F    &kp G
        &kp A    &kp A    &kp X    &kp C    &kp V    &kp B
        &kp A    &kp Z    &kp A    &kp A    &kp A    &kp A    &kp A
                                             &studio_unlock   &kp A
                        >;
                };
        };
};
